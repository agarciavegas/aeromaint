# ============================================================
# Configuracion de n8n - Copia este archivo como .env
# y rellena los valores
# ============================================================

# --- Credenciales de n8n ---
N8N_USER=admin
N8N_PASSWORD=CambiaEstoPorUnaPasswordSegura123!

# --- Dominio (si tienes uno, sino deja localhost) ---
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# --- OpenAI API (necesaria para el agente IA) ---
# Consigue una en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-tu_openai_api_key_aqui

# --- n8n API Key (se genera despues de instalar) ---
N8N_API_KEY=se_genera_despues_de_instalar
