{
  "name": "Template - Web Scraper Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 60
            }
          ]
        }
      },
      "id": "cron-scraper",
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.TARGET_URL }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        }
      },
      "id": "fetch-page",
      "name": "Obtener Pagina",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "extractValues": {
          "values": [
            {
              "key": "content",
              "cssSelector": "={{ $env.CONTENT_SELECTOR || 'body' }}",
              "returnValue": "text"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-content",
      "name": "Extraer Contenido",
      "type": "n8n-nodes-base.htmlExtract",
      "typeVersion": 1,
      "position": [690, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "fileName": "=/home/node/.n8n/scraper-state/{{ $env.SCRAPER_ID || 'default' }}.txt"
      },
      "id": "read-last",
      "name": "Leer Estado Anterior",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [690, 500]
    },
    {
      "parameters": {
        "jsCode": "const currentContent = $input.first().json.content || '';\nconst previousContent = $('Leer Estado Anterior').item.json.data || '';\n\n// Comparacion simple\nconst hasChanged = currentContent.trim() !== previousContent.trim();\n\n// Detectar diferencias simples\nlet diff = '';\nif (hasChanged) {\n  const currentLines = currentContent.split('\\n').filter(l => l.trim());\n  const previousLines = new Set(previousContent.split('\\n').filter(l => l.trim()));\n  const newLines = currentLines.filter(l => !previousLines.has(l));\n  diff = newLines.slice(0, 10).join('\\n'); // Max 10 lineas nuevas\n}\n\nreturn {\n  json: {\n    hasChanged,\n    diff: diff.substring(0, 2000), // Limitar tamanho\n    currentContent: currentContent.substring(0, 500), // Preview\n    url: $env.TARGET_URL\n  }\n};"
      },
      "id": "compare-content",
      "name": "Comparar Cambios",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.hasChanged }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-changes",
      "name": "Hay Cambios?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1130, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🚨 *Cambio Detectado!*\n\n🌐 *URL:* {{ $json.url }}\n📝 *Novedades:*\n{{ $json.diff }}\n\n⏰ {{ new Date().toLocaleString('es-ES', { timeZone: 'Europe/Madrid' }) }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "notify-telegram",
      "name": "Notificar Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1350, 200]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/home/node/.n8n/scraper-state/{{ $env.SCRAPER_ID || 'default' }}.txt",
        "data": "={{ $('Extraer Contenido').item.json.content }}"
      },
      "id": "save-state",
      "name": "Guardar Estado",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [1350, 400]
    }
  ],
  "connections": {
    "Cada hora": {
      "main": [
        [
          {
            "node": "Obtener Pagina",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener Pagina": {
      "main": [
        [
          {
            "node": "Extraer Contenido",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extraer Contenido": {
      "main": [
        [
          {
            "node": "Comparar Cambios",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Comparar Cambios": {
      "main": [
        [
          {
            "node": "Hay Cambios?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hay Cambios?": {
      "main": [
        [
          {
            "node": "Notificar Telegram",
            "type": "main",
            "index": 0
          },
          {
            "node": "Guardar Estado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "template"
    },
    {
      "name": "scraper"
    }
  ]
}
