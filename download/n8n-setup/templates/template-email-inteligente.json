{
  "name": "Template - Email Inteligente",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "id": "email-trigger",
      "name": "Nuevo Email",
      "type": "n8n-nodes-base.emailTrigger",
      "typeVersion": 2.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "Eres un clasificador de emails. Analiza cada email y clasificalo en una de estas categorias:\n\n- URGENTE: Requiere atencion inmediata (palabras como: urgente, ASAP, hoy, inmediatamente)\n- FACTURA: Es una factura o recibo (contiene: factura, recibo, importe, pago)\n- NEWSLETTER: Boletin o contenido informativo\n- TRABAJO: Relacionado con trabajo profesional\n- PERSONAL: Email personal\n- SPAM: Spam o no deseado\n\nResponde SOLO con un JSON como este:\n{\"categoria\": \"URGENTE\", \"resumen\": \"Resumen en una linea\", \"accion\": \"que hacer\"}"
        }
      },
      "id": "classify-email",
      "name": "Clasificar con IA",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [470, 300]
    },
    {
      "parameters": {
        "jsCode": "const category = $json.output;\nlet parsed;\ntry {\n  parsed = JSON.parse(category);\n} catch {\n  parsed = { categoria: 'PERSONAL', resumen: 'No se pudo clasificar', accion: 'Revisar manualmente' };\n}\n\nconst email = $('Nuevo Email').item.json;\nconst isUrgent = parsed.categoria === 'URGENTE';\nconst isInvoice = parsed.categoria === 'FACTURA';\n\nreturn {\n  json: {\n    from: email.from,\n    subject: email.subject,\n    category: parsed.categoria,\n    summary: parsed.resumen,\n    action: parsed.accion,\n    isUrgent,\n    isInvoice,\n    textPreview: (email.text || '').substring(0, 500)\n  }\n};"
      },
      "id": "process-classification",
      "name": "Procesar Clasificacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "urgent-condition",
              "leftValue": "={{ $json.isUrgent }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-urgent",
      "name": "Es Urgente?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🚨 *EMAIL URGENTE!*\n\n📧 *De:* {{ $json.from }}\n📌 *Asunto:* {{ $json.subject }}\n🏷 *Categoria:* {{ $json.category }}\n📝 *Resumen:* {{ $json.summary }}\n✅ *Accion:* {{ $json.action }}\n\n💬 _{{ $json.textPreview }}_",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "urgent-telegram",
      "name": "Alerta Urgente",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1130, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=📧 *Nuevo Email*\n\n📌 *Asunto:* {{ $json.subject }}\n🏷 *Categoria:* {{ $json.category }}\n📝 *Resumen:* {{ $json.summary }}\n✅ *Accion:* {{ $json.action }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "normal-telegram",
      "name": "Resumen Email",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1130, 400]
    }
  ],
  "connections": {
    "Nuevo Email": {
      "main": [
        [
          {
            "node": "Clasificar con IA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Clasificar con IA": {
      "main": [
        [
          {
            "node": "Procesar Clasificacion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Procesar Clasificacion": {
      "main": [
        [
          {
            "node": "Es Urgente?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Es Urgente?": {
      "main": [
        [
          {
            "node": "Alerta Urgente",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Resumen Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "template"
    },
    {
      "name": "email"
    }
  ]
}
