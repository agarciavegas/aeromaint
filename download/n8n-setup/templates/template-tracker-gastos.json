{
  "name": "Template - Tracker de Gastos",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "gasto-command",
              "leftValue": "={{ $json.message.text }}",
              "rightValue": "/gasto",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-command",
      "name": "Es comando /gasto?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "jsCode": "const text = $('Telegram Trigger').item.json.message.text;\nconst parts = text.replace('/gasto', '').trim().split(' ');\n\nlet amount = 0;\nlet category = 'otros';\nlet description = '';\n\n// Parsear: /gasto 25 comida pizza\n// o: /gasto 25.50\nif (parts.length >= 1) {\n  amount = parseFloat(parts[0]) || 0;\n}\nif (parts.length >= 2) {\n  // Segundo podria ser categoria o descripcion\n  const knownCategories = ['comida', 'transporte', 'ocio', 'compras', 'salud', 'casa', 'trabajo', 'otros'];\n  if (knownCategories.includes(parts[1].toLowerCase())) {\n    category = parts[1].toLowerCase();\n    description = parts.slice(2).join(' ');\n  } else {\n    description = parts.slice(1).join(' ');\n  }\n}\n\nconst date = new Date().toLocaleDateString('es-ES');\nconst time = new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });\n\nreturn {\n  json: {\n    amount,\n    category,\n    description,\n    date,\n    time,\n    raw: text\n  }\n};"
      },
      "id": "parse-expense",
      "name": "Parsear Gasto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        },
        "sheetName": "Gastos",
        "options": {}
      },
      "id": "save-sheets",
      "name": "Guardar en Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [910, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.from.id }}",
        "text": "=✅ *Gasto registrado!*\n\n💰 *Cantidad:* {{ $json.amount }}€\n🏷 *Categoria:* {{ $json.category }}\n📝 *Descripcion:* {{ $json.description }}\n📅 *Fecha:* {{ $json.date }} {{ $json.time }}\n\n_Escribe /resumen para ver tus gastos_",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "confirm-telegram",
      "name": "Confirmar Registro",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1130, 200]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Es comando /gasto?",
