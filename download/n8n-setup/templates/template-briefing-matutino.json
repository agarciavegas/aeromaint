{
  "name": "Template - Briefing Matutino",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "cron-morning",
      "name": "Cada dia 7:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://api.openweathermap.org/data/2.5/weather?q=Madrid,ES&appid={{ $env.OPENWEATHER_API_KEY }}&units=metric&lang=es",
        "options": {}
      },
      "id": "weather",
      "name": "Obtener Tiempo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [470, 200]
    },
    {
      "parameters": {
        "url": "https://api.exchangerate-api.com/v4/latest/EUR",
        "options": {}
      },
      "id": "exchange",
      "name": "Obtener Divisas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [470, 400]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "options": {}
      },
      "id": "merge-data",
      "name": "Combinar Datos",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [690, 300]
    },
    {
      "parameters": {
        "jsCode": "const weather = $input.item.json[0];\nconst exchange = $input.item.json[1];\n\nconst today = new Date().toLocaleDateString('es-ES', { \n  weekday: 'long', \n  year: 'numeric', \n  month: 'long', \n  day: 'numeric' \n});\n\nconst willRain = weather.weather[0].main === 'Rain';\nconst rainEmoji = willRain ? '☔ LLEVAR PARAGUAS!' : '☀️ Sin lluvia prevista';\n\nconst message = `🌅 *Buenos dias!* _${today}_\n\n` +\n`🌡 *Tiempo en Madrid:*\n` +\n`  • Temperatura: ${Math.round(weather.main.temp)}°C\n` +\n`  • Sensacion: ${Math.round(weather.main.feels_like)}°C\n` +\n`  • ${weather.weather[0].description}\n` +\n`  • ${rainEmoji}\n\n` +\n`💱 *Divisas:*\n` +\n`  • 1 EUR = ${exchange.rates.USD.toFixed(2)} USD\n` +\n`  • 1 EUR = ${exchange.rates.GBP.toFixed(2)} GBP\n` +\n`  • 1 EUR = ${exchange.rates.JPY.toFixed(2)} JPY\n\n` +\n`¡Que tengas un gran dia! 💪`;\n\nreturn { json: { message } };"
      },
      "id": "format-message",
      "name": "Formatear Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-briefing",
      "name": "Enviar Briefing",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1130, 300]
    }
  ],
  "connections": {
    "Cada dia 7:00": {
      "main": [
        [
          {
            "node": "Obtener Tiempo",
            "type": "main",
            "index": 0
          },
          {
            "node": "Obtener Divisas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener Tiempo": {
      "main": [
        [
          {
            "node": "Combinar Datos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener Divisas": {
      "main": [
        [
          {
            "node": "Combinar Datos",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Combinar Datos": {
      "main": [
        [
          {
            "node": "Formatear Mensaje",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatear Mensaje": {
      "main": [
        [
          {
            "node": "Enviar Briefing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "template"
    },
    {
      "name": "briefing"
    }
  ]
}
