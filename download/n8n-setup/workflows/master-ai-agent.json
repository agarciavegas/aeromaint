{
  "name": "Master AI Agent - Telegram Bot",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.message.from.id }}",
              "operation": "equal",
              "value2": "={{ $env.TELEGRAM_CHAT_ID }}"
            }
          ]
        }
      },
      "id": "check-chat-id",
      "name": "Verificar Usuario",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $json.message.from.id }}",
        "text": "⛔ No tienes permiso para usar este bot.",
        "additionalFields": {}
      },
      "id": "reject-user",
      "name": "Rechazar Usuario",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [690, 480]
    },
    {
      "parameters": {
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "Eres un asistente de automatizacion personal llamado n8nBot. Gestionas los workflows de n8n del usuario a traves de Telegram.\n\nCAPACIDADES:\n- Crear, modificar, eliminar workflows de n8n\n- Activar/desactivar automatizaciones\n- Consultar estado de workflows y ejecuciones\n- Crear recordatorios y eventos en calendario\n- Buscar informacion en internet\n- Enviar emails y notificaciones\n- Monitorizar webs y precios\n- Gestionar datos en bases de datos\n\nREGLAS IMPORTANTES:\n- Siempre confirma antes de ELIMINAR un workflow (pregunta: \"Seguro que quieres eliminar X?\")\n- Al crear workflows, explica siempre que hara cada uno\n- Sugiere mejoras cuando veas oportunidades de automatizacion\n- Responde siempre en espanol\n- Se conciso pero informativo\n- Usa emojis para hacer las respuestas mas visuales\n\nSEGURIDAD:\n- Nunca elimines este workflow maestro (Master AI Agent)\n- Pide confirmacion para operaciones destructivas\n- No expongas la API key ni credenciales\n- No ejecutes comandos del sistema\n\nFORMATO DE RESPUESTA:\n- Para listar workflows: usa listas numeradas con emojis\n- Para crear: muestra resumen de lo creado\n- Para eliminar: pide confirmacion primero\n- Para errores: explica el problema y sugiere solucion\n\nCuando uses las herramientas, usa los nombres exactos de las funciones disponibles.",
          "temperature": 0.3
        }
      },
      "id": "ai-agent",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [690, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      },
      "id": "openai-model",
      "name": "OpenAI Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [910, 480]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "memory",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [910, 300]
    },
    {
      "parameters": {
        "name": "listar_workflows",
        "description": "Lista todos los workflows de n8n. Devuelve nombre, ID, estado (activo/inactivo) y numero de nodos de cada workflow.",
        "method": "GET",
        "url": "=http://localhost:5678/api/v1/workflows",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "tool-list-workflows",
      "name": "Listar Workflows",
      "type": "@n8n/n8n-nodes-langchain.toolHttp",
      "typeVersion": 1.1,
      "position": [1130, 100]
    },
    {
      "parameters": {
        "name": "obtener_workflow",
        "description": "Obtiene los detalles completos de un workflow especifico por su ID. Necesario para ver los nodos y conexiones de un workflow.",
        "method": "GET",
        "url": "=http://localhost:5678/api/v1/workflows/{{ $workflowId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "tool-get-workflow",
      "name": "Obtener Workflow",
      "type": "@n8n/n8n-nodes-langchain.toolHttp",
      "typeVersion": 1.1,
      "position": [1130, 180]
    },
    {
      "parameters": {
        "name": "crear_workflow",
        "description": "Crea un nuevo workflow en n8n. El body debe incluir: name (nombre), nodes (array de nodos), connections (objeto de conexiones), active (booleano). Usa esta herramienta para crear nuevas automatizaciones.",
        "method": "POST",
        "url": "=http://localhost:5678/api/v1/workflows",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $workflowJson }}",
        "options": {}
      },
      "id": "tool-create-workflow",
      "name": "Crear Workflow",
      "type": "@n8n/n8n-nodes-langchain.toolHttp",
      "typeVersion": 1.1,
      "position": [1130, 260]
    },
    {
      "parameters": {
        "name": "eliminar_workflow",
        "description": "Elimina un workflow de n8n por su ID. IMPORTANTE: Siempre pide confirmacion al usuario antes de eliminar. Nunca elimines el workflow 'Master AI Agent'.",
        "method": "DELETE",
        "url": "=http://localhost:5678/api/v1/workflows/{{ $workflowId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "tool-delete-workflow",
      "name": "Eliminar Workflow",
      "type": "@n8n/n8n-nodes-langchain.toolHttp",
      "typeVersion": 1.1,
      "position": [1130, 340]
    },
    {
      "parameters": {
        "name": "activar_workflow",
        "description": "Activa un workflow de n8n para que se ejecute segun su trigger programado.",
        "method": "POST",
        "url": "=http://localhost:5678/api/v1/workflows/{{ $workflowId }}/activate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "tool-activate-workflow",
      "name": "Activar Workflow",
      "type": "@n8n/n8n-nodes-langchain.toolHttp",
      "typeVersion": 1.1,
      "position": [1130, 420]
    },
    {
      "parameters": {
        "name": "desactivar_workflow",
        "description": "Desactiva un workflow de n8n. El workflow se mantiene pero no se ejecuta automaticamente.",
        "method": "POST",
        "url": "=http://localhost:5678/api/v1/workflows/{{ $workflowId }}/deactivate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "tool-deactivate-workflow",
      "name": "Desactivar Workflow",
      "type": "@n8n/n8n-nodes-langchain.toolHttp",
      "typeVersion": 1.1,
      "position": [1130, 500]
    },
    {
      "parameters": {
        "name": "ver_ejecuciones",
        "description": "Obtiene el historial de ejecuciones de workflows. Permite ver si un workflow se ha ejecutado correctamente o ha fallado.",
        "method": "GET",
        "url": "=http://localhost:5678/api/v1/executions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "tool-list-executions",
      "name": "Ver Ejecuciones",
      "type": "@n8n/n8n-nodes-langchain.toolHttp",
      "typeVersion": 1.1,
      "position": [1130, 580]
    },
    {
      "parameters": {
        "name": "modificar_workflow",
        "description": "Modifica un workflow existente. Se usa para anadir, quitar o cambiar nodos y conexiones de un workflow.",
        "method": "PUT",
        "url": "=http://localhost:5678/api/v1/workflows/{{ $workflowId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $workflowJson }}",
        "options": {}
      },
      "id": "tool-update-workflow",
      "name": "Modificar Workflow",
      "type": "@n8n/n8n-nodes-langchain.toolHttp",
      "typeVersion": 1.1,
      "position": [1130, 660]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.from.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-response",
      "name": "Responder Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1350, 300]
    }
  ],
